    "check": "tsc -b",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
