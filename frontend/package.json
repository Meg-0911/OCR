{
  "name": "han-viet-corpus-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check:fonts": "node scripts/check-fonts.mjs",
    "prebuild": "npm run check:fonts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
