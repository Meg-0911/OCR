# Copy to backend/.env and supply the token from the Kim Han Nom website cookie.
# Keep your existing backend/.env if KHN_token is already present.
KHN_token=
KHN_BASE_URL=https://kimhannom.fit.hcmus.edu.vn
KHN_TIMEOUT_SECONDS=180
KHN_USER_AGENT=NomWorkspace/0.1

# Vietnamese handwriting OCR runs locally on CPU; no API key needed.
VI_OCR_PROVIDER=vietocr
VI_OCR_THREADS=4
# Optional local Tesseract paths (otherwise use backend/.tools/tesseract/).
# TESSERACT_CMD=
# TESSDATA_DIR=
